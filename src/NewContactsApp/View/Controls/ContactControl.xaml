<UserControl x:Class="View.Controls.ContactControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:View.Controls"
             xmlns:vm="clr-namespace:View.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <vm:BooleanInverseConverter x:Key="BooleanInverse"/>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                    <Setter Property="Background" Value="LightPink"/>
                    <Setter Property="Margin" Value="3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Margin" Value="3,3,3,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8" Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Width="100" Height="100" VerticalAlignment="Top" 
               Source="/user.ico" Margin="0,0,10,0"/>

        <StackPanel Grid.Column="1" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Label Content="Name:"/>
                    <TextBox x:Name="NameTextBox" IsReadOnly="{Binding IsEditMode, Converter={StaticResource BooleanInverse}}">
                        <TextBox.Text>
                            <Binding Path="CurrentContact.Name" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <DataErrorValidationRule/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <Label Content="Phone number:"/>
                    <TextBox x:Name="PhoneTextBox" IsReadOnly="{Binding IsEditMode, Converter={StaticResource BooleanInverse}}" 
                             PreviewTextInput="PhoneNumberTextBox_PreviewTextInput" DataObject.Pasting="PhoneNumberTextBox_Pasting">
                        <TextBox.Text>
                            <Binding Path="CurrentContact.PhoneNumber" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <DataErrorValidationRule/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <Label Content="Email:"/>
                    <TextBox x:Name="EmailTextBox" IsReadOnly="{Binding IsEditMode, Converter={StaticResource BooleanInverse}}">
                        <TextBox.Text>
                            <Binding Path="CurrentContact.Email" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <DataErrorValidationRule/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
