<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        xmlns:vm="clr-namespace:View.ViewModel"
        xmlns:controls="clr-namespace:View.Controls"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Icon="icon.png">

    <Window.DataContext>
        <vm:MainVM />
    </Window.DataContext>

    <Window.Resources>
        <vm:BoolToVisibilityConverter x:Key="BooleanToVisibility"/>
        <vm:BooleanInverseConverter x:Key="BooleanInverse"/>

        <DataTemplate x:Key="contactTemplate">
            <StackPanel Margin="3" Orientation="Horizontal">
                <Image Width="40" Height="40" Margin="0,0,8,0" VerticalAlignment="Center"
                       Source="user.ico"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Name}"/>
                    <TextBlock FontSize="10" Text="{Binding PhoneNumber}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.Resources>
            <Style TargetType="{x:Type Label}">
                <Setter Property="Margin" Value="3"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="{x:Type Button}">
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Height" Value="25"/>
                <Setter Property="Width" Value="70"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Margin" Value="3"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="5">
            <Grid DockPanel.Dock="Top" Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Label Content="Find:" Grid.Column="0"/>
                <TextBox x:Name="SearchTextBox" Height="20" Grid.Column="1" Margin="3,0,0,0"/>
            </Grid>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                <Button x:Name="AddButton" Content="Add" Width="79.5" Height="25" Margin="3"
                        Command="{Binding AddCommand}" CommandParameter="{Binding CurrentContact}"/>
                <Button x:Name="EditButton" Content="Edit" Width="79.5" Height="25" Margin="3"
                        Command="{Binding EditCommand}" CommandParameter="{Binding CurrentContact}"/>
                <Button x:Name="RemoveButton" Content="Remove" Width="79.5" Height="25" Margin="3"
                        Command="{Binding RemoveCommand}" CommandParameter="{Binding CurrentContact}"/>
            </StackPanel>

            <ListBox x:Name="ContactsListBox" ItemTemplate="{StaticResource contactTemplate}" 
                     ItemsSource="{Binding Contacts}" SelectedItem="{Binding CurrentContact}"
                     Margin="0,5,0,0"/>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="White"/>

        <Grid Grid.Column="2" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:ContactControl Grid.Row="0"/>

            <Button x:Name="ApplyButton" Grid.Row="1" Content="Apply" HorizontalAlignment="Left" 
                    Command="{Binding ApplyCommand}" Margin="121,0,0,210" Width="79.5" Height="25"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibility}}"
                    />
        </Grid>
    </Grid>
</Window>