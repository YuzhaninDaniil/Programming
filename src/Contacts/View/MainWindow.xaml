<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        xmlns:vm="clr-namespace:View.ViewModel"
        mc:Ignorable="d"
        Title="Contacts" Height="450" Width="500">

    <Window.DataContext>
        <vm:MainVM />
    </Window.DataContext>

    <DockPanel Margin="15">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,9,0">
            <Button Content="Save" Width="75" Height="25" Command="{Binding SaveCommand}"/>
            <Button Content="Load" Width="75" Height="25" Margin="3" Command="{Binding LoadCommand}"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Edit Contact" Grid.Column="0" Margin="10,10,4,10">
                <StackPanel Margin="0">
                    <Label Content="Name:" Margin="3"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="3,3,3,3"/>
                    <Label Content="Phone Number:" Margin="3"/>
                    <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Margin="3,3,3,3"/>
                    <Label Content="Email:" Margin="3"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="3,3,3,3"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Read Contact" Grid.Column="1" Margin="4,10,10,10">
                <StackPanel Margin="0">
                    <Label Content="Name:" Margin="3"/>
                    <TextBlock Text="{Binding Name}" Margin="3,3,3,3" FontWeight="Bold"/>
                    <Label Content="Phone Number:" Margin="3"/>
                    <TextBlock Text="{Binding PhoneNumber}" Margin="3,3,3,3" FontWeight="Bold"/>
                    <Label Content="Email:" Margin="3"/>
                    <TextBlock Text="{Binding Email}" Margin="3,3,3,3" FontWeight="Bold"/>
                </StackPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
